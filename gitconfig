[hub]
protocol = ssh 

[credential]
helper = /opt/boxen/bin/boxen-git-credential

[core]
excludesfile = /opt/boxen/config/git/gitignore
	editor = vim
[user]
	email = malnick@gmail.com
	name = malnick
	signingkey = E092FED552B5C762 

[alias]
	br = branch
	copr = "!f() { git fetch origin pull/$1/head:pr$1; }; f"
	trainadd = "!f() { git copr $1; git merge --no-ff pr$1 -m \"Merge #$1\"; git br -D pr$1; }; f"
	unstage = reset HEAD --
	hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
	last = log -1 HEAD
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[commit]
	gpgsign = true
